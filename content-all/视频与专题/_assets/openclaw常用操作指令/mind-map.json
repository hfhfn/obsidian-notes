{
  "name": "OpenClaw (OpenCloud) 基本操作指南",
  "children": [
    {
      "name": "初始化与重置",
      "children": [
        {
          "name": "opencloud init",
          "children": [
            {
              "name": "重新走一遍初始设置流程"
            }
          ]
        }
      ]
    },
    {
      "name": "配置管理 (config)",
      "children": [
        {
          "name": "opencloud config",
          "children": [
            {
              "name": "model: 独立设置模型"
            },
            {
              "name": "channels: 配置聊天渠道"
            }
          ]
        }
      ]
    },
    {
      "name": "运行状态检查",
      "children": [
        {
          "name": "opencloud status",
          "children": [
            {
              "name": "查看运行状态与错误信息"
            }
          ]
        }
      ]
    },
    {
      "name": "Gateway 服务控制",
      "children": [
        {
          "name": "前台运行: opencloud gateway"
        },
        {
          "name": "后台服务安装: opencloud gateway install"
        },
        {
          "name": "后台启动: opencloud gateway start"
        },
        {
          "name": "停止服务: opencloud gateway stop"
        },
        {
          "name": "重启服务: opencloud gateway restart"
        }
      ]
    },
    {
      "name": "快捷访问",
      "children": [
        {
          "name": "opencloud dashboard",
          "children": [
            {
              "name": "自动带Token打开Web界面"
            }
          ]
        }
      ]
    },
    {
      "name": "故障排查",
      "children": [
        {
          "name": "opencloud logs --follow",
          "children": [
            {
              "name": "实时查看运行日志"
            },
            {
              "name": "排查API Key或认证错误"
            }
          ]
        }
      ]
    },
    {
      "name": "系统更新",
      "children": [
        {
          "name": "opencloud update",
          "children": [
            {
              "name": "修复Bug与提升安全性"
            }
          ]
        }
      ]
    }
  ]
}